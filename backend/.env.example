# GLM 5 API配置
GLM_API_KEY=your_glm_api_key
GLM_API_BASE=https://api.example.com/glm5

# Qwen Plus API配置
QWEN_API_KEY=your_qwen_api_key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Doubao API配置
DOBAO_API_KEY=your_doubao_api_key
DOBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# 数据库配置
DATABASE_URL=sqlite:///./data/langgraph_data.db

# Tavily API配置
TAVILY_API_KEY=your_tavily_api_key

# LangSmith配置 - 用于监控和调试LangChain应用
# LANGSMITH_TRACING: 是否启用LangSmith追踪功能
# LANGSMITH_ENDPOINT: LangSmith API端点
# LANGSMITH_API_KEY: LangSmith API密钥
# LANGSMITH_PROJECT: 项目名称
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT="your_project_name"
